{
  "name": "football-backend",
  "version": "1.0.0",
  "description": "High-performance Fastify backend with Redis caching and single-flight deduplication for 10,000 concurrent football users",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:cluster": "node dist/cluster.js"
  },
  "keywords": ["football", "fastify", "redis", "postgresql", "10k-concurrency"],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
