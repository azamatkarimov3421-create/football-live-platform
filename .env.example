# ===================================================================
# FOOTBALL LIVE PLATFORM - ENVIRONMENT CONFIGURATION
# Optimized for 10,000 Concurrent Users on a Single Server
# ===================================================================

# Football-Data.org API Token (KEEP SECRET, NEVER EXPOSE TO FRONTEND)
# Register for free at: https://www.football-data.org/client/register
FOOTBALL_API_KEY=YOUR_TOKEN_HERE
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
UPSTREAM_TIMEOUT_MS=8000

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Redis Cache Service
REDIS_URL=redis://redis:6379

# PostgreSQL Database (Connection Pooling)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/football_db
DB_POOL_MAX=30
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Security & Rate Limiting
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=60000
